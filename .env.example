# Qdrant Cloud cluster with Cloud Inference enabled. Querying needs it: the
# function sends text, not a vector, and nothing here can embed.
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Optional; these are the defaults.
# COLLECTION_NAME=goods-en
# EMBEDDINGS_MODEL=mixedbread-ai/mxbai-embed-large-v1
# TOP_K=3
